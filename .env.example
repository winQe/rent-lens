# Optional overrides for the local docker compose stack. Copy to .env (git ignores it) and change
# what you need; the defaults in docker-compose.yml work without this file.

# Host ports, for when the defaults are already in use.
WEB_PORT=8080
API_PORT=3000
DB_PORT=5432

# Database passwords. They go into connection URLs, so use letters, digits, "-" and "_" only.
# The API and ingest passwords need at least 12 characters and can change at any time: the setup
# job sets them again on every start. The owner password is fixed when the database volume is
# first created; to change it later, run `docker compose down -v` (this deletes the local data).
DB_OWNER_PASSWORD=rentlens
API_DB_PASSWORD=rentlens-api-local
INGEST_DB_PASSWORD=rentlens-ingest-local
