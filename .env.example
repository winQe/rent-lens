# Optional overrides for the local docker compose stack. Copy to .env (git ignores it) to use your own.
# The defaults in docker-compose.yml work without this file. Passwords need at least 12 characters,
# except the owner's. Change them before the first `docker compose up`, or run `docker compose down -v`.
DB_OWNER_PASSWORD=rentlens
API_DB_PASSWORD=rentlens-api-local
INGEST_DB_PASSWORD=rentlens-ingest-local
