{
  "name": "rent-lens",
  "private": true,
  "description": "RentLens: find where you can rent an HDB flat on your budget, from data.gov.sg rental approvals.",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "yarn workspace @rent-lens/api dev",
    "dev:web": "yarn workspace @rent-lens/web dev",
    "build": "yarn workspaces foreach -A --topological run build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "test": "yarn workspaces foreach -A run test",
    "migrate": "yarn workspace @rent-lens/api migrate",
    "ingest": "yarn workspace @rent-lens/api ingest",
    "roles": "yarn workspace @rent-lens/api roles",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
